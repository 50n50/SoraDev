{
  "name": "sora-dev-windows",
  "version": "0.0.1",
  "description": "Windows development port of Sora iOS/macOS with proper module support",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "electron . --enable-logging",
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-packager . SoraModuleDev --platform=win32 --arch=x64 --out=dist --overwrite"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/50n50/SoraDev.git"
  },
  "build": {
    "appId": "com.sora.moduledev",
    "productName": "Sora Module Developer",
    "icon": "icon.png",
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "50n50",
      "repo": "SoraDev",
      "releaseType": "release"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!dist/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}